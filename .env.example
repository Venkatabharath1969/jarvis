# =============================================================================
# JARVIS CEO Assistant — Environment Variables Reference
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=jarvis
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional explicit DSN (overrides the fields above if set)
# DATABASE_URL=postgresql+asyncpg://jarvis:changeme@db:5432/jarvis

# ── Application ───────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
SECRET_KEY=generate_with_openssl_rand_hex_32
DEBUG=false

# ── Feature flags ─────────────────────────────────────────────────────────────
# true  → use PostgreSQL mock DB (local meetings data)
# false → use Microsoft Graph API (live Outlook calendar / inbox)
USE_MOCK_DATA=true

# ── LLM — Groq (primary, recommended) ────────────────────────────────────────
# Free API key at https://console.groq.com/  — 1000 RPM, no daily limit
# When GROQ_API_KEY is set, Gemini is NOT used.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── LLM — Google Gemini (fallback — only used if GROQ_API_KEY is blank) ──────
# Free API key at https://aistudio.google.com/ — limited to 20 RPD on free tier
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ── Microsoft Graph API (only needed when USE_MOCK_DATA=false) ────────────────
# Step 1: Azure Portal → Azure Active Directory → App registrations → New
# Step 2: API permissions → Add a permission → Microsoft Graph → Application permissions
# Step 3: Add all of: Calendars.Read, OnlineMeetings.Read, CallRecords.Read.All,
#         OnlineMeetings.ReadTranscript.All, Mail.Read, Tasks.Read, People.Read
# Step 4: Click "Grant admin consent for <tenant>" → green checkmarks appear
# Step 5: Certificates & secrets → New client secret → copy the value
# Step 6: Fill in the values below, set USE_MOCK_DATA=false, restart backend
#
# Teams Admin Center (admin.teams.microsoft.com) — for transcription:
#   Meetings → Meeting policies → Allow cloud recording = ON, Allow transcription = ON
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=your_client_secret_here
# The UPN (email) of the user whose calendar/inbox/transcripts to query
GRAPH_USER_UPN=user@your-org.com
