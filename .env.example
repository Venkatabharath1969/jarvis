# Database
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=jarvis
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jarvis:changeme_use_strong_password@db:5432/jarvis

# App
APP_PORT=8000
SECRET_KEY=generate_with_openssl_rand_hex_32
DEBUG=false

# Feature flags
USE_MOCK_DATA=true

# LLM - FREE - get key at aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# APK serving
APK_PATH=/apk/jarvis.apk

# Microsoft Graph (only needed when USE_MOCK_DATA=false)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER_UPN=ceo@mercedes-benz.com
