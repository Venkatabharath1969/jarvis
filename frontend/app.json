{
  "expo": {
    "name": "JARVIS",
    "slug": "jarvis-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#0A0A0A",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.jarvis.ceo",
      "versionCode": 1,
      "permissions": ["RECORD_AUDIO", "INTERNET", "VIBRATE"]
    },
    "plugins": [
      ["expo-av", {"microphonePermission": "JARVIS needs microphone access to hear your voice commands"}]
    ]
  }
}
